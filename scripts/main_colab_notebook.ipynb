    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "os.makedirs('images', exist_ok=True)\n",
        "print('📁 Папка images готова. Перетащите ваши фото в неё через левую панель Colab.')"
      ],
      "metadata": { "id": "setup" },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# --- СКРИПТ 1: Базовая склейка ---\n",
        "from moviepy.editor import ImageClip, concatenate_videoclips\n",
        "\n",
        "IMAGE_FOLDER = \"images\"\n",
        "OUTPUT_FILE = \"output_basic.mp4\"\n",
        "DURATION = 3.0\n",
        "SIZE = (1080, 1440)\n",
        "\n",
        "files = sorted([os.path.join(IMAGE_FOLDER, f) for f in os.listdir(IMAGE_FOLDER) if f.lower().endswith(('.png', '.jpg', '.jpeg'))])\n",
        "if files:\n",
        "    clips = [ImageClip(f, duration=DURATION).resize(SIZE).set_position('center') for f in files]\n",
        "    concatenate_videoclips(clips, method=\"compose\").write_videofile(OUTPUT_FILE, fps=24, codec=\"libx264\", audio=False, logger=None)\n",
        "    print(f'✅ Готово: {OUTPUT_FILE}')\n",
        "else:\n",
        "    print('⚠️ Нет фото в папке images')"
      ],
      "metadata": { "id": "script1" },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# --- СКРИПТ 2: Плавные переходы ---\n",
        "from moviepy.editor import ImageClip, CompositeVideoClip\n",
        "\n",
        "OUTPUT_FILE = \"output_crossfade.mp4\"\n",
        "FADE = 0.5\n",
        "\n",
        "if files:\n",
        "    clips = []\n",
        "    for i, f in enumerate(files):\n",
        "        c = ImageClip(f, duration=DURATION).resize(SIZE).set_position('center')\n",
        "        c = c.set_start(0) if i == 0 else c.set_start(i * (DURATION - FADE)).crossfadein(FADE)\n",
        "        clips.append(c)\n",
        "    dur = len(clips) * DURATION - (len(clips) - 1) * FADE\n",
        "    CompositeVideoClip(clips, size=SIZE).set_duration(dur).write_videofile(OUTPUT_FILE, fps=24, codec=\"libx264\", audio=False, logger=None)\n",
        "    print(f'✅ Готово: {OUTPUT_FILE}')"
      ],
      "metadata": { "id": "script2" },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# --- СКРИПТ 3: Эффект зума (Ken Burns) ---\n",
        "OUTPUT_FILE = \"output_zoom.mp4\"\n",
        "ZOOM = 1.15\n",
        "\n",
        "if files:\n",
        "    clips = []\n",
        "    for f in files:\n",
        "        base = ImageClip(f, duration=DURATION).resize((int(SIZE[0]*ZOOM), int(SIZE[1]*ZOOM)))\n",
        "        anim = base.resize(lambda t: ZOOM - (ZOOM - 1.0) * (t / DURATION)).set_position('center')\n",
        "        clips.append(anim)\n",
        "    concatenate_videoclips(clips, method=\"compose\").write_videofile(OUTPUT_FILE, fps=24, codec=\"libx264\", audio=False, logger=None)\n",
        "    print(f'✅ Готово: {OUTPUT_FILE}')"
      ],
